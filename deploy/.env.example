LEM_DOMAIN=lem.rodrod.pt
# Gerar uma chave hexadecimal, sem caracteres especiais em URLs:
# openssl rand -hex 24
POSTGRES_PASSWORD=
ADMIN_EMAIL=admin@lem.pt
# Password inicial de pelo menos 12 caracteres. .env só deve ser legível pelo administrador.
ADMIN_PASSWORD=

# Oldest compatible client and latest supported client; semantic versions (no v prefix).
# Every API request except health/compatibility requires X-Lem-Client-Version.
LEM_MIN_CLIENT_VERSION=0.9.1
LEM_LATEST_CLIENT_VERSION=0.10.0
# Optional HTTPS download or update instructions; leave empty until available.
LEM_UPDATE_URL=
LEM_EXPORT_CONCURRENCY=2
LEM_IMAGE_CONCURRENCY=1
LEM_DOWNLOAD_CONCURRENCY=8
LEM_API_DOCS=0

# Nome usado apenas ao criar a primeira conta numa base de dados vazia
ADMIN_NAME=Administrador
